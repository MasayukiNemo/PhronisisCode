#!/usr/bin/env bash
set -o pipefail
# pre-push hook: handover.md SHA 検証 + session_log整合性 + coreファイル差分 + code health check
HOOK_DIR="$(dirname "$0")"
PROJECT_DIR="$(cd "$HOOK_DIR/.." && pwd)"

# 1. handover check
bash "$HOOK_DIR/python_run.sh" "$HOOK_DIR/handover_check.py"
HOOK_EXIT=$?
if [ $HOOK_EXIT -ne 0 ]; then
  exit $HOOK_EXIT
fi

# 2. code health check (Code self-verification gate - BLOCK)
bash "$HOOK_DIR/python_run.sh" "$PROJECT_DIR/scripts/code_health_check.py" --no-color
HEALTH_EXIT=$?
if [ $HEALTH_EXIT -ne 0 ]; then
  echo "[BLOCK] code_health_check failed (exit $HEALTH_EXIT). fix required." >&2
  exit $HEALTH_EXIT
fi

# Google Sheets同期は2026-08-15に廃止（使用していない・SC遅延の原因のため。根本さん決定）

exit 0
